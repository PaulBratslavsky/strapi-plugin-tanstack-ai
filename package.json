{
  "version": "1.2.0",
  "keywords": [
    "strapi",
    "strapi-plugin",
    "tanstack",
    "tanstack-ai",
    "ai",
    "chat",
    "mcp",
    "model-context-protocol",
    "llm",
    "ollama",
    "anthropic"
  ],
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify && npm run lint && npm run check:seam && npm run test",
    "test:ts:front": "tsc -p admin/tsconfig.json",
    "test:ts:back": "tsc -p server/tsconfig.json",
    "check:seam": "node scripts/check-seam.mjs",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:model": "MODEL_TESTS=1 playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "npm run verify && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@strapi/design-system": "^2.2.4",
    "@strapi/icons": "^2.2.4",
    "@strapi/sdk-plugin": "^6.1.1",
    "@strapi/strapi": "^5.52.3",
    "@strapi/typescript-utils": "^5.52.3",
    "@strapi/utils": "^5.52.3",
    "@tanstack/ai": "^0.52.0",
    "@tanstack/ai-anthropic": "^0.18.3",
    "@tanstack/ai-ollama": "^0.10.3",
    "@tanstack/ai-react": "^0.22.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "eslint": "^10.10.0",
    "eslint-plugin-regexp": "^3.3.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.8.9",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.30.6",
    "remark-gfm": "^4.0.1",
    "styled-components": "^6.5.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "@strapi/design-system": "^2.0.0",
    "@strapi/icons": "^2.0.0",
    "@strapi/strapi": "^5.47.0",
    "@strapi/utils": "^5.47.0",
    "@tanstack/ai": "^0.52.0",
    "@tanstack/ai-anthropic": "^0.18.0",
    "@tanstack/ai-ollama": "^0.10.0",
    "@tanstack/ai-react": "^0.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.6.0",
    "react-router-dom": "^6.30.0",
    "styled-components": "^6.0.0"
  },
  "strapi": {
    "kind": "plugin",
    "name": "tanstack-ai",
    "displayName": "TanStack AI",
    "description": "Cross-type content tools for Strapi's MCP server, and an optional in-admin chat"
  },
  "name": "strapi-plugin-tanstack-ai",
  "description": "Cross-type content tools for Strapi's MCP server, and an optional in-admin chat",
  "license": "MIT",
  "author": "Paul Bratslavsky <paul.bratslavsky@strapi.io>",
  "peerDependenciesMeta": {
    "@tanstack/ai": {
      "optional": true
    },
    "@tanstack/ai-react": {
      "optional": true
    },
    "@tanstack/ai-anthropic": {
      "optional": true
    },
    "@tanstack/ai-ollama": {
      "optional": true
    }
  },
  "dependencies": {
    "react-markdown": "^9.0.0",
    "remark-gfm": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PaulBratslavsky/strapi-plugin-tanstack-ai.git"
  },
  "homepage": "https://github.com/PaulBratslavsky/strapi-plugin-tanstack-ai#readme",
  "bugs": {
    "url": "https://github.com/PaulBratslavsky/strapi-plugin-tanstack-ai/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
